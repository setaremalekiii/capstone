from PIL import Image
import os

# input image path
img_path = r".\CVAE\class_2\val\103082_class2_5.jpg"
print("hello")
print(img_path)

# output folder
out_dir = "rotated"
os.makedirs(out_dir, exist_ok=True)

img = Image.open(img_path)

for angle in range(1, 360):
    rotated = img.rotate(angle, resample=Image.BICUBIC, expand=True)
    rotated.save(os.path.join(out_dir, f"rotss_{angle:03d}_class2_5.jpg"))

print("Done.")